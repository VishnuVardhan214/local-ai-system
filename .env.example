# Copy this file to .env in the project folder. Anything set here overrides config/config.yaml.
# The pattern is LAI_<SECTION>__<KEY>, with two underscores between the parts.
# No secrets are needed to run this system. If you add a tool that needs an API key,
# put the key here and read it with os.environ. Never write keys into the code.

# Where the app keeps its databases, uploaded documents and logs
# LAI_PATHS__DATA_DIR=~/local-ai-data

# The only folders the file tools may touch. This is a list, written in YAML style.
# LAI_PATHS__WORKSPACE_DIRS=["~/ai-workspace"]

# Model and memory settings
# LAI_BACKEND__MODEL=qwen3:4b
# LAI_GENERATION__NUM_CTX=4096
# LAI_GENERATION__NUM_THREAD=6
# LAI_GENERATION__NUM_GPU=
# LAI_GENERATION__KEEP_ALIVE=10m

# RAG: auto, ollama or hashing
# LAI_RAG__EMBEDDER=auto

# Let the run_tests tool run without asking (not recommended)
# LAI_SECURITY__AUTO_APPROVE_TESTS=false

# Web interface port. The host stays 127.0.0.1 unless you also set LAI_ALLOW_REMOTE=1 (not recommended).
# LAI_UI__PORT=8000
